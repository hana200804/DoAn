# Chép thành .env (không commit) và đổi toàn bộ mật khẩu.
MYSQL_ROOT_PASSWORD=change-me-root
# 01-databases.sql cấp quyền cho user tên "signa"; đổi tên thì sửa cả file đó
DB_USER=signa
DB_PASSWORD=change-me-db

MINIO_ACCESS_KEY=signa
# Bắt buộc tự đặt: cổng 9000 mở ra ngoài, docker compose không chạy nếu để trống
MINIO_SECRET_KEY=
# Địa chỉ điện thoại dùng để tải ảnh lên MinIO: IP máy chạy Docker trong mạng LAN, ví dụ http://192.168.1.10:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Tài khoản quản trị đầu tiên, mật khẩu ≥ 12 ký tự
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

VIETMAP_API_KEY=

# Để trống thì OTP quên mật khẩu chỉ ghi ra log của auth-service
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
