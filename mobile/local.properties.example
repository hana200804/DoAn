# Keep sdk.dir generated by Android Studio in your own local.properties.
# Never commit your real key.
VIETMAP_API_KEY=
# Search key can also authorize Route; rebuild after changing keys.
VIETMAP_SEARCH_API_KEY=
# Optional. Defaults to VIETMAP_SEARCH_API_KEY when blank.
VIETMAP_ROUTE_API_KEY=
API_BASE_URL=http://10.0.2.2:8080/api/v1/
